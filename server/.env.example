# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
# IMPORTANTE: debe ser la SERVICE_ROLE key (Dashboard -> Project Settings -> API
# -> service_role). Es secreta y solo vive en el backend. El backend NO arranca
# si se configura la anon key.
SUPABASE_KEY=tu-service-role-key

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu-api-key-aqui

# Modelo (opcional, default: gemini-2.5-flash)
# SCAN_MODEL=gemini-2.5-flash

# --- Opcionales (tienen defaults sensatos) ---
# Cuota de escaneo por empresa (protege el costo de Gemini)
# SCAN_RATE_PER_MIN=20
# SCAN_RATE_PER_DAY=300
# Timeout de la llamada a Gemini en milisegundos
# GEMINI_TIMEOUT_MS=45000
# Tamano maximo de imagen de comprobante (MB)
# MAX_IMAGE_MB=6
# Tamano maximo del body de cualquier request (MB)
# MAX_REQUEST_MB=12
# TTL de las URLs firmadas de comprobantes (segundos)
# SIGNED_URL_TTL=3600
# Bucket de comprobantes (privado)
# COMPROBANTES_BUCKET=comprobantes
# URL del frontend para el link de recuperacion de contrasena
# RESET_REDIRECT_URL=https://tu-frontend/#/reset-password
