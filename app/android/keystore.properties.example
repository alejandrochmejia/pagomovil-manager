# Copia este archivo a `keystore.properties` (ignorado por git) para firmar
# builds de release en local. En CI estas credenciales vienen de GitHub Secrets
# como variables de entorno (ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
# ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD), no de este archivo.
#
# Generar el keystore una sola vez (guardar la copia y las claves en un lugar seguro):
#   keytool -genkeypair -v -keystore release.keystore -alias pagomovil \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile es la ruta al .keystore (relativa al modulo app/ o absoluta).

storeFile=release.keystore
storePassword=CAMBIAR
keyAlias=pagomovil
keyPassword=CAMBIAR
