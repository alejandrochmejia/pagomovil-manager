# En dev: el frontend llama a /api y Vite lo reenvia al backend
# (configurado en vite.config.ts -> server.proxy). Deja VITE_API_URL vacio.
#
# En build de produccion / APK Capacitor: el proxy NO existe.
# Define VITE_API_URL apuntando al backend publico:
#   VITE_API_URL=https://pagomovil-manager-api.onrender.com
#
# (.env.production ya lo trae configurado para vite build)
